# Frontend values must use the VITE_ prefix.
VITE_API_BASE_URL=http://localhost:8000

# The POC keeps its SQLite configuration local.
CALL_RADAR_DATABASE_PATH=data/call_radar.db

# Optional: use a different local sample directory when testing seed behavior.
# CALL_RADAR_SAMPLE_DATA_DIR=sample-data/callradar-data
CALL_RADAR_LOG_LEVEL=INFO
